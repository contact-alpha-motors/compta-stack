# Copier en ".env" puis remplir. Ne JAMAIS commiter le vrai .env.
# Mots de passe : lettres et chiffres uniquement (pas de ' " $ \ @ :), 24 caractères ou plus.
# Générer par exemple avec :  openssl rand -hex 16

DB_NAME=compta
DB_ADMIN_USER=compta_admin
DB_ADMIN_PASSWORD=
AGENT_DB_PASSWORD=
STUDIO_DB_PASSWORD=

TZ=Africa/Douala
STUDIO_PORT=8080

# Agent : moteur LLM via OpenRouter — clé API pour lire les factures (obligatoire pour `ingest`)
OPENROUTER_API_KEY=
# Optionnel : surcharger le modèle ou l'endpoint sans toucher au code
# EXTRACT_MODEL=google/gemini-3.8-flash
# CATEGORIZE_MODEL=google/gemini-3.8-flash
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Mini-app de virements « Assistant Caisse » (module B — ordre de virement). Voir GUIDE_BOT_VIREMENTS.md.
# L'agent se connecte en tant qu'utilisateur Supabase dédié (jamais la service key).
SUPABASE_URL=
SUPABASE_ANON_KEY=
API_BASE_URL=http://app-assistante/api
BOT_EMAIL=laurent@alphamotors-cameroun.com
BOT_PASSWORD=

# Bot Lark (connexion longue — pas d'URL publique). Un espace Lark = une instance du bot.
LARK_APP_ID=
LARK_APP_SECRET=
LARK_REPORT_CHAT_ID=
